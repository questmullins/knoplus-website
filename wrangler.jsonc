{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knoplus-website",
  "compatibility_date": "2026-06-05",
  "main": "./worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{"pattern":"kno.plus","custom_domain":true}],
  "assets": {
    "directory": "./nextjs-elements/out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{"binding":"CLIENT_DB","database_name":"knoplus-clients","database_id":"9c723a22-a9bc-4104-92d7-a933d9dcb145"}],
  // Annex (annex/) reads its account's .sql schema files as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Annex pulls every connected account's sales each night; Square's webhook keeps them fresh in between.
  "triggers": { "crons": ["17 8 * * *"] },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "info@kno.plus"
    }
  ],
  // Keys shared with the RoseWave worker live once, in the account's Secrets Store; Annex reads each as the name
  // after "->" (annex/src/index.js, STORED): SQUARE_TOKEN -> ROSEWAVE_SQUARE_TOKEN, PRODIGI_KEY -> ROSEWAVE_PRODIGI_KEY,
  // ROSEWAVE_ANNEX_KEY -> ROSEWAVE_ANNEX_KEY. A Worker secret of the same name still works when the store has none.
  "secrets_store_secrets": [
    { "binding": "STORE_SQUARE_TOKEN", "store_id": "25406ed6729e44a4a615fdd095d1dad7", "secret_name": "SQUARE_TOKEN" },
    { "binding": "STORE_PRODIGI_KEY", "store_id": "25406ed6729e44a4a615fdd095d1dad7", "secret_name": "PRODIGI_KEY" },
    { "binding": "STORE_ROSEWAVE_ANNEX_KEY", "store_id": "25406ed6729e44a4a615fdd095d1dad7", "secret_name": "ROSEWAVE_ANNEX_KEY" }
  ],
  "vars": {
    "CONTACT_TO": "info@kno.plus",
    "CONTACT_FROM": "Knoplus <info@kno.plus>",
    "ANNEX_ACCOUNT": "rosewave"
  },
  "observability": {
    "enabled": true
  }
}
